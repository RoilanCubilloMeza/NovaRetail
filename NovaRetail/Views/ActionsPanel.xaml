<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NovaRetail.Controls"
             x:Class="NovaRetail.Views.ActionsPanel">

    <Border Style="{DynamicResource PanelCard}"
            Margin="6,10,12,10">

        <ScrollView>
            <VerticalStackLayout Spacing="0" Padding="8,10">

                <!-- Tipo de Cambio -->
                <Border Style="{DynamicResource InfoDisplayBorder}"
                        Margin="0,0,0,12"
                        Padding="10,8">
                    <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="2">

                        <!-- Fila 1: etiqueta + icono refresh -->
                        <Grid Grid.Row="0"
                              ColumnDefinitions="*, Auto" ColumnSpacing="4">
                            <Label Grid.Column="0"
                                   Text="Tipo de Cambio"
                                   FontSize="{DynamicResource UIFontXS}"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource Gray500}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="{Binding ExchangeRateRefreshIcon}"
                                   FontSize="{DynamicResource UIFontXS}"
                                   TextColor="#0284C7"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding RefreshExchangeRateCommand}"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <!-- Fila 2: valor principal -->
                        <Grid Grid.Row="1"
                              ColumnDefinitions="*">
                            <Label Grid.Column="0"
                                   Text="{Binding ExchangeRateText}"
                                   FontSize="{DynamicResource UIFontLG}"
                                   FontAttributes="Bold"
                                   TextColor="#111827"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="NoWrap"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <!-- Fila 3: leyenda de moneda -->
                        <Grid Grid.Row="2"
                              ColumnDefinitions="*">
                            <Label Grid.Column="0"
                                   Text="{Binding ExchangeRateSourceText}"
                                   FontSize="{DynamicResource UIFontXS}"
                                   TextColor="#9CA3AF"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="NoWrap"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Center"/>
                        </Grid>

                    </Grid>
                </Border>

                <BoxView Style="{DynamicResource FormDivider}" Margin="0,0,0,14"/>

                <!-- Action Buttons -->
                <VerticalStackLayout Spacing="6">

                    <controls:ActionLinkRow Icon="&#x1F4CB;" Text="Cotización"
                                            Command="{Binding OpenQuoteMenuCommand}"
                            SurfaceColor="{DynamicResource ActionLink_SurfaceColor}"
                            StrokeColor="{DynamicResource ActionLink_StrokeColor}"
                            IconColor="{DynamicResource ActionLink_IconColor}"
                            LabelColor="{DynamicResource ActionLink_LabelColor}"
                            ArrowColor="{DynamicResource ActionLink_ArrowColor}"/>

                    <controls:ActionLinkRow Icon="&#x23F8;&#xFE0E;" Text="Fac. Espera"
                                            Command="{Binding OpenHoldMenuCommand}"
                                                                       SurfaceColor="{DynamicResource ActionLink_SurfaceColor}"
                            StrokeColor="{DynamicResource ActionLink_StrokeColor}"
                            IconColor="{DynamicResource ActionLink_IconColor}"
                            LabelColor="{DynamicResource ActionLink_LabelColor}"
                            ArrowColor="{DynamicResource ActionLink_ArrowColor}"/>

                    <controls:ActionLinkRow Icon="&#x1F9D1;" Text="Vendedor"
                                            Command="{Binding AssignSalesRepCommand}"
                                            IsVisible="{Binding ShowSalesRepFeature}"
                                                                       SurfaceColor="{DynamicResource ActionLink_SurfaceColor}"
                            StrokeColor="{DynamicResource ActionLink_StrokeColor}"
                            IconColor="{DynamicResource ActionLink_IconColor}"
                            LabelColor="{DynamicResource ActionLink_LabelColor}"
                            ArrowColor="{DynamicResource ActionLink_ArrowColor}"/>

                    <controls:ActionLinkRow Icon="&#x1F4E6;" Text="Ord. Trabajo"
                                            Command="{Binding OpenWorkOrderMenuCommand}"
                                                                     SurfaceColor="{DynamicResource ActionLink_SurfaceColor}"
                            StrokeColor="{DynamicResource ActionLink_StrokeColor}"
                            IconColor="{DynamicResource ActionLink_IconColor}"
                            LabelColor="{DynamicResource ActionLink_LabelColor}"
                            ArrowColor="{DynamicResource ActionLink_ArrowColor}"/>

                    <controls:ActionLinkRow Icon="&#x1F9FE;" Text="Historial"
                                            Command="{Binding ShowInvoiceHistoryCommand}"
                                                                       SurfaceColor="{DynamicResource ActionLink_SurfaceColor}"
                            StrokeColor="{DynamicResource ActionLink_StrokeColor}"
                            IconColor="{DynamicResource ActionLink_IconColor}"
                            LabelColor="{DynamicResource ActionLink_LabelColor}"
                            ArrowColor="{DynamicResource ActionLink_ArrowColor}"/>

                    <controls:ActionLinkRow Icon="&#x21A9;" Text="NC por Clave"
                                            Command="{Binding StandaloneCreditNoteCommand}"
                                                                      SurfaceColor="{DynamicResource ActionLink_SurfaceColor}"
                            StrokeColor="{DynamicResource ActionLink_StrokeColor}"
                            IconColor="{DynamicResource ActionLink_IconColor}"
                            LabelColor="{DynamicResource ActionLink_LabelColor}"
                            ArrowColor="{DynamicResource ActionLink_ArrowColor}"/>

                    <controls:ActionLinkRow Icon="&#x1F4B3;" Text="Abonos"
                                            Command="{Binding ShowCreditPaymentCommand}"
                                                                       SurfaceColor="{DynamicResource ActionLink_SurfaceColor}"
                            StrokeColor="{DynamicResource ActionLink_StrokeColor}"
                            IconColor="{DynamicResource ActionLink_IconColor}"
                            LabelColor="{DynamicResource ActionLink_LabelColor}"
                            ArrowColor="{DynamicResource ActionLink_ArrowColor}"/>

                    <controls:ActionLinkRow Icon="&#x1F4CA;" Text="Administración"
                                            Command="{Binding OpenAdminMenuCommand}"
                                            IsVisible="{Binding CanAccessAdminActions}"
                                                                      SurfaceColor="{DynamicResource ActionLink_SurfaceColor}"
                            StrokeColor="{DynamicResource ActionLink_StrokeColor}"
                            IconColor="{DynamicResource ActionLink_IconColor}"
                            LabelColor="{DynamicResource ActionLink_LabelColor}"
                            ArrowColor="{DynamicResource ActionLink_ArrowColor}"/>
                    <BoxView Style="{DynamicResource FormDivider}" Margin="0,8,0,8"/>

                    <controls:ActionLinkRow Icon="&#x1F4C2;" Text="Personalización"
                                            Command="{Binding NavigateToCategoryConfigCommand}"
                                                                      SurfaceColor="{DynamicResource ActionLink_SurfaceColor}"
                            StrokeColor="{DynamicResource ActionLink_StrokeColor}"
                            IconColor="{DynamicResource ActionLink_IconColor}"
                            LabelColor="{DynamicResource ActionLink_LabelColor}"
                            ArrowColor="{DynamicResource ActionLink_ArrowColor}"/>

                    <controls:ActionLinkRow Icon="&#x1F6AA;" Text="Cerrar sesión"
                                            Command="{Binding LogoutCommand}"
                                                                     SurfaceColor="{DynamicResource ActionLink_SurfaceColor}"
                            StrokeColor="{DynamicResource ActionLink_StrokeColor}"
                            IconColor="{DynamicResource ActionLink_IconColor}"
                            LabelColor="{DynamicResource ActionLink_LabelColor}"
                            ArrowColor="{DynamicResource ActionLink_ArrowColor}"/>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Border>

</ContentView>
